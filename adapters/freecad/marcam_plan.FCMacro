# marcam: plan a marcam operation on the selected FreeCAD body (FreeCAD macro).
#
# Needs the `marcam` Python package where FreeCAD's Python finds it, and this folder's
# marcam_freecad module (put the folder on sys.path, or copy the module next to the macro).
# Asks for the operation and the output folder; every other input is marcam's default.
import os
import sys

import FreeCAD as App
import FreeCADGui as Gui

try:
    HERE = os.path.dirname(os.path.abspath(__file__))
except NameError:  # run without a file name: the user's macro folder
    HERE = App.getUserMacroDir(True)
sys.path.insert(0, HERE)
import marcam
import marcam_freecad as fc

OPERATIONS = [t["kind"] for t in marcam.call("op_types") if t["geometry"] != ["profile"]]


def run(operation=None, out_dir=None, **inputs):
    sel = Gui.Selection.getSelection()
    if len(sel) != 1 or not hasattr(sel[0], "Shape"):
        raise ValueError("select one body to machine")
    if operation is None or out_dir is None:
        from PySide import QtGui  # FreeCAD's Qt binding; only when asking

        operation, ok = QtGui.QInputDialog.getItem(None, "marcam", "Operation:", OPERATIONS, 0, False)
        if not ok:
            return None
        out_dir = QtGui.QFileDialog.getExistingDirectory(None, "marcam: write the G-code to")
        if not out_dir:
            return None
    result = fc.plan(sel[0], operation, out_dir=out_dir, **inputs)
    App.Console.PrintMessage(f"marcam {operation} on {sel[0].Label}:\n{fc.summary(result)}\n"
                             f"written to {out_dir}: {', '.join(result['files'])}\n")
    return result


if __name__ == "__main__":
    run()
