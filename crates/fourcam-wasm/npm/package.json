{
  "name": "fourcam",
  "version": "0.1.0",
  "description": "4th-axis rotary CAM engine in WebAssembly: plan, post, simulate and estimate CNC programs (JSON in, JSON out), in Node and browsers",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/malvira/4cam.git", "directory": "crates/fourcam-wasm" },
  "homepage": "https://github.com/malvira/4cam",
  "keywords": ["cam", "cnc", "gcode", "4th-axis", "toolpath", "webassembly"],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./fourcam.js": "./fourcam.js",
    "./fourcam.wasm": "./fourcam.wasm"
  },
  "files": ["index.js", "index.d.ts", "fourcam.js", "fourcam.wasm", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
